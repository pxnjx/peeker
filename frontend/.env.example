# Peeker frontend configuration. Copy to `.env.local` and fill in.
# Next.js only reads .env.local (and .env), never this example file.

# Signs the peeker_session cookie. MUST be byte-identical to PEEKER_SESSION_SECRET
# in backend/.env — the backend re-verifies the same HMAC. Without it, sign-in is
# disabled and every /api route returns 503. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
PEEKER_SESSION_SECRET=

# First-run account. Only read while data/users.json is empty; afterwards the
# store owns the password and this has no effect. Change it under Settings.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Public origin used for absolute OpenGraph/Twitter/sitemap URLs. Without it the
# build emits localhost:3001, which is wrong the moment the site is published.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Backend location. Leave unset to use the same-origin /backend proxy (default,
# and what keeps the session cookie on one host). Set it only if you are NOT
# proxying, and note an absolute URL must be same-host for the cookie to travel.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# BACKEND_ORIGIN=http://127.0.0.1:8000
