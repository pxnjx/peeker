# Peeker backend configuration. Copy to `.env` and fill in.
# Every value here is optional except PEEKER_SESSION_SECRET — the backend refuses
# to serve any data route (503) without it, because it could not verify a session.

# Signs the dashboard session cookie (HMAC-SHA256). MUST be byte-identical to
# PEEKER_SESSION_SECRET in frontend/.env.local: Next.js mints the cookie with it
# and this app re-verifies the same HMAC. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
PEEKER_SESSION_SECRET=

# --- optional overrides; defaults live in app/config.py -------------------
# PEEKER_LOG_LEVEL=INFO
# PEEKER_DEBUG=false
# PEEKER_DATABASE_URL=sqlite+aiosqlite:///./data/peeker.db
# PEEKER_WORKER_CONCURRENCY=3
# PEEKER_MIN_NAVIGATION_INTERVAL_S=60
# PEEKER_CRAWLER_CHANNEL=chrome
# PEEKER_CRAWLER_HEADLESS=true
# PEEKER_CRAWLER_MAX_REVIEWS=100
# PEEKER_CRAWLER_PROXY_URL=
# PEEKER_DEFAULT_INTERVAL_MIN_OWN=60
# PEEKER_DEFAULT_INTERVAL_MIN_COMPETITOR=240
# PEEKER_BLOCK_BACKOFF_MINUTES=5,15,60
# PEEKER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
